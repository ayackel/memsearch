{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-stop.sh\"",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh\"",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmit": [
      {
        "type": "command",
        "bash": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh\"",
        "timeoutSec": 5
      }
    ]
  }
}
