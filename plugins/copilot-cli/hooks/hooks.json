{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"${MEMSEARCH_PLUGIN_DIR:-$HOME/.copilot/installed-plugins/local/memsearch}/hooks/session-start.sh\"",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash \"${MEMSEARCH_PLUGIN_DIR:-$HOME/.copilot/installed-plugins/local/memsearch}/hooks/agent-stop.sh\"",
        "timeoutSec": 15
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash \"${MEMSEARCH_PLUGIN_DIR:-$HOME/.copilot/installed-plugins/local/memsearch}/hooks/session-end.sh\"",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmit": [
      {
        "type": "command",
        "bash": "bash \"${MEMSEARCH_PLUGIN_DIR:-$HOME/.copilot/installed-plugins/local/memsearch}/hooks/user-prompt-submit.sh\"",
        "timeoutSec": 5
      }
    ]
  }
}
